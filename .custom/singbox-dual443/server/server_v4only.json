{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "inbounds": [
    {
      "tag": "VLESS-Vision-Reality-in",
      "type": "vless",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "users": [
        {
          "uuid": "REPLACE_WITH_UUID",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "www.cloudflare.com",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "www.cloudflare.com",
            "server_port": 443
          },
          "private_key": "REPLACE_WITH_REALITY_PRIVATE_KEY",
          "short_id": [
            "REPLACE_WITH_REALITY_SHORT_ID"
          ]
        }
      },
      "multiplex": {
        "enabled": true,
        "padding": true
      }
    },
    {
      "tag": "hysteria-in",
      "type": "hysteria2",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "users": [
        {
          "password": "REPLACE_WITH_HYSTERIA2_PASSWORD"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "REPLACE_WITH_HY2_SNI",
        "certificate_path": "REPLACE_WITH_CERTIFICATE_PATH",
        "key_path": "REPLACE_WITH_KEY_PATH"
      }
    },
    {
      "tag": "vless-ws-in",
      "type": "vless",
      "listen": "0.0.0.0",
      "listen_port": 8443,
      "users": [
        {
          "uuid": "REPLACE_WITH_WS_UUID"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "REPLACE_WITH_WS_SNI",
        "certificate_path": "REPLACE_WITH_WS_CERTIFICATE_PATH",
        "key_path": "REPLACE_WITH_WS_KEY_PATH"
      },
      "transport": {
        "type": "ws",
        "path": "REPLACE_WITH_WS_PATH",
        "headers": {
          "Host": "REPLACE_WITH_WS_SNI"
        },
        "max_early_data": 2048,
        "early_data_header_name": "Sec-WebSocket-Protocol"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "ip_version": 6,
        "action": "reject",
        "no_drop": true
      }
    ],
    "final": "direct"
  }
}
