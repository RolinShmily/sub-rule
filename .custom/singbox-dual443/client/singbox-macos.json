{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local",
        "prefer_go": true
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "tx",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "默认代理"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.19.0.0/16"
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ]
        }
      },
      {
        "tag": "tailscale-dns",
        "type": "udp",
        "server": "100.100.100.100",
        "detour": "直连-tailscale"
      }
    ],
    "rules": [
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "domain_suffix": [
          "REPLACE_WITH_HEADSCALE_BASE_DOMAIN"
        ],
        "server": "tailscale-dns"
      },
      {
        "domain_suffix": [
          "REPLACE_WITH_HEADSCALE_SERVER"
        ],
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "rule_set": [
          "fakeipfilter-cn",
          "geosite-cn",
          "geosite-microsoft@cn",
          "geosite-apple@cn",
          "geosite-private"
        ],
        "server": "ali"
      },
      {
        "rule_set": "fakeipfilter-!cn",
        "server": "google"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "google",
        "client_subnet": "223.5.5.0/24",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": "geoip-cn",
        "server": "ali"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "google",
    "strategy": "ipv4_only",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true
    },
    "reverse_mapping": true
  },
  "outbounds": [
    {
      "tag": "默认代理",
      "type": "selector",
      "outbounds": [
        "自建-Reality",
        "自建-Hy2"
      ]
    },
    {
      "tag": "自建-Reality",
      "type": "vless",
      "server": "REPLACE_WITH_NODE_ADDRESS",
      "server_port": 443,
      "uuid": "REPLACE_WITH_UUID",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "www.cloudflare.com",
        "reality": {
          "enabled": true,
          "public_key": "REPLACE_WITH_REALITY_PUBLIC_KEY",
          "short_id": "01234567"
        },
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "multiplex": {
        "enabled": true,
        "padding": true
      }
    },
    {
      "tag": "自建-Hy2",
      "type": "hysteria2",
      "server": "REPLACE_WITH_NODE_ADDRESS",
      "server_port": 443,
      "password": "REPLACE_WITH_HYSTERIA2_PASSWORD",
      "tls": {
        "enabled": true,
        "server_name": "REPLACE_WITH_HY2_SNI",
        "insecure": false
      }
    },
    {
      "tag": "直连",
      "type": "direct",
      "domain_resolver": "ali"
    },
    {
      "tag": "直连-tailscale",
      "type": "direct",
      "domain_resolver": "tailscale-dns"
    }
  ],
  "http_clients": [
    {
      "tag": "直连下载",
      "detour": "直连"
    }
  ],
  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": "push.apple.com"
          },
          {
            "rule_set": "geoip-telegram"
          }
        ],
        "invert": true,
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "stun",
          "quic",
          "dns"
        ],
        "timeout": "100ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "直连"
      },
      {
        "ip_cidr": [
          "100.64.0.0/10",
          "fd7a:115c:a1e0::/48"
        ],
        "outbound": "直连-tailscale"
      },
      {
        "domain_suffix": [
          "REPLACE_WITH_HEADSCALE_BASE_DOMAIN"
        ],
        "outbound": "直连-tailscale"
      },
      {
        "port": [
          3478,
          41641
        ],
        "network": "udp",
        "outbound": "直连"
      },
      {
        "domain_suffix": [
          "REPLACE_WITH_HEADSCALE_SERVER"
        ],
        "outbound": "直连"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": [
              "stun",
              "quic"
            ]
          }
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "network": "icmp",
        "action": "resolve"
      },
      {
        "network": "icmp",
        "outbound": "直连"
      },
      {
        "clash_mode": "Direct",
        "outbound": "直连"
      },
      {
        "clash_mode": "Global",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-category-ai-!cn",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-youtube",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-google",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-github",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-onedrive",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-microsoft@cn",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-microsoft",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-apple@cn",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-apple",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-telegram",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-tiktok",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-netflix",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-paypal",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-binance",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-okx",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-category-cryptocurrency",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-steam@cn",
        "outbound": "直连"
      },
      {
        "rule_set": "geosite-steam",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "默认代理"
      },
      {
        "inbound": "mixed-in",
        "action": "resolve"
      },
      {
        "rule_set": "geoip-telegram",
        "outbound": "默认代理"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "直连"
      }
    ],
    "rule_set": [
      {
        "tag": [
          "fakeipfilter-cn",
          "fakeipfilter-!cn"
        ],
        "type": "remote",
        "format": "source",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/RolinShmily/sub-rule/refs/heads/main/rules/{tag}.json"
      },
      {
        "tag": [
          "geosite-category-ai-!cn",
          "geosite-youtube",
          "geosite-google",
          "geosite-github",
          "geosite-onedrive",
          "geosite-microsoft",
          "geosite-microsoft@cn",
          "geosite-apple",
          "geosite-apple@cn",
          "geosite-telegram",
          "geosite-tiktok",
          "geosite-netflix",
          "geosite-paypal",
          "geosite-binance",
          "geosite-okx",
          "geosite-category-cryptocurrency",
          "geosite-steam@cn",
          "geosite-steam",
          "geosite-geolocation-!cn",
          "geosite-cn",
          "geosite-private"
        ],
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"
      },
      {
        "tag": "geoip-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "final": "默认代理",
    "default_http_client": "直连下载",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "ali"
    }
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 2080,
          "bypass_domain": [
            "<local>",
            "localhost",
            "127.*",
            "10.*",
            "172.16.*",
            "172.17.*",
            "172.18.*",
            "172.19.*",
            "172.20.*",
            "172.21.*",
            "172.22.*",
            "172.23.*",
            "172.24.*",
            "172.25.*",
            "172.26.*",
            "172.27.*",
            "172.28.*",
            "172.29.*",
            "172.30.*",
            "172.31.*",
            "192.168.*",
            "100.*",
            "REPLACE_WITH_HEADSCALE_SERVER",
            "REPLACE_WITH_HEADSCALE_BASE_DOMAIN"
          ]
        }
      },
      "route_exclude_address": [
        "100.64.0.0/10",
        "fd7a:115c:a1e0::/48"
      ]
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "secret": "REPLACE_WITH_API_SECRET",
      "dashboard": {
        "enabled": false
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  },
  "certificate": {
    "store": "chrome"
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}
